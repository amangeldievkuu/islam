<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio streaming & offline caching of recitations -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Leaving Home" geofence. Background location must be requested separately,
         after foreground location has been granted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Driving detection (ActivityTransition IN_VEHICLE) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Car Bluetooth connection (ACTION_ACL_CONNECTED + reading the paired device) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Contextual dua notifications with lock-screen actions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptic Tasbih -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Geofences are cleared on reboot and must be re-registered -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Media3 MediaSessionService for "Play Audio" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <application
        android:name=".SunnahCompanionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunnahCompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SunnahCompanion"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock-screen notification actions ("Mark as Read", "Play Audio") -->
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <!-- Leaving-home geofence; invoked through a PendingIntent owned by this app -->
        <receiver
            android:name=".trigger.geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Activity Recognition IN_VEHICLE transitions; PendingIntent-only -->
        <receiver
            android:name=".trigger.driving.DrivingDetectionReceiver"
            android:exported="false" />

        <!-- Sent by the Bluetooth stack (not the system uid), so it must be exported.
             ACL_CONNECTED is a protected broadcast that other apps cannot spoof. -->
        <receiver
            android:name=".trigger.driving.BluetoothCarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".trigger.schedule.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".trigger.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager is initialised on demand by SunnahCompanionApp (Configuration.Provider)
             so workers can be constructed by Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Exported so system media controls, Bluetooth and Android Auto can bind;
             Media3 vets each controller in MediaSession.Callback.onConnect. -->
        <service
            android:name=".audio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
